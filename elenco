import numpy as np
import pandas as pd
import xgboost as xgb
from sklearn.base import BaseEstimator, ClassifierMixin
from sklearn.model_selection import cross_val_predict, StratifiedKFold
from sklearn.calibration import CalibratedClassifierCV
from sklearn.utils import check_X_y

class ElkanNotoPUClassifier(BaseEstimator, ClassifierMixin):
    """
    Positive-Unlabeled (PU) Classifier based on Elkan & Noto (2008).
    Treats 'Normal' users as Unlabeled (mixture of Pos/Neg) rather than pure Negatives.
    """
    def __init__(self, estimator=None, hold_out_ratio=0.2, n_jobs=-1, random_state=42):
        self.estimator = estimator
        self.c = None # The constant P(s=1|y=1)
        self.hold_out_ratio = hold_out_ratio
        self.n_jobs = n_jobs
        self.random_state = random_state
        self.final_estimator = None
        
        # Default estimator if none provided
        if self.estimator is None:
            self.estimator = xgb.XGBClassifier(
                n_estimators=200,
                max_depth=5,
                learning_rate=0.05,
                n_jobs=self.n_jobs,
                random_state=self.random_state,
                eval_metric='logloss'
            )

    def fit(self, X_pos, X_unlabeled):
        """
        X_pos: DataFrame/Array of 'Approved' customers (Labeled Positive)
        X_unlabeled: DataFrame/Array of 'Normal' customers (Unlabeled)
        """
        # Convert to numpy if pandas
        X_pos = X_pos.values if hasattr(X_pos, 'values') else X_pos
        X_unlabeled = X_unlabeled.values if hasattr(X_unlabeled, 'values') else X_unlabeled

        # Create the 'Observation' Dataset (s=1 for Approved, s=0 for Normal)
        X_all = np.vstack([X_pos, X_unlabeled])
        y_all = np.concatenate([np.ones(len(X_pos)), np.zeros(len(X_unlabeled))])
        
        print(f"--- Step 1: Estimating P(s=1|x) on {len(X_all)} samples ---")
        
        # We need calibrated probabilities for P(s=1|x) to estimate 'c' accurately.
        # We use Cross-Validation to get cleaner out-of-sample probs for the training data.
        # This prevents overfitting where the model just memorizes the 1s.
        cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=self.random_state)
        
        # Get Probabilities P(s=1|x)
        # Note: We use a clone to avoid fitting the self.estimator instance yet
        prob_s = cross_val_predict(
            self.estimator, X_all, y_all, cv=cv, method='predict_proba', n_jobs=self.n_jobs
        )[:, 1]
        
        # ---------------------------------------------------------
        # ESTIMATE 'c' (The Label Frequency)
        # ---------------------------------------------------------
        # c = Average P(s=1|x) for the Labeled Positive examples
        # Logic: "How likely is a Known Positive to look like a Known Positive?"
        prob_s_positives = prob_s[:len(X_pos)]
        self.c = np.mean(prob_s_positives)
        
        print(f"Estimated c (P(s=1|y=1)): {self.c:.4f}")
        print(f"Interpretation: Roughly {self.c*100:.1f}% of credit-worthy customers have applied.")

        # ---------------------------------------------------------
        # CALCULATE WEIGHTS FOR UNLABELED DATA
        # ---------------------------------------------------------
        # Formula: w(x) = [(1-c)/c] * [P(s=1|x) / (1 - P(s=1|x))]
        prob_s_unlabeled = prob_s[len(X_pos):]
        
        # Clip probabilities to prevent division by zero or infinity
        prob_s_unlabeled = np.clip(prob_s_unlabeled, 0.00001, 0.99999)
        
        numerator = (1 - self.c) * prob_s_unlabeled
        denominator = self.c * (1 - prob_s_unlabeled)
        weights_unlabeled = numerator / denominator
        
        # Weight cannot exceed 1.0 (Probability logic)
        weights_unlabeled = np.clip(weights_unlabeled, 0, 1.0)
        
        print(f"--- Step 2: Preparing Weighted Training Data ---")
        
        # ---------------------------------------------------------
        # CREATE WEIGHTED DATASET
        # ---------------------------------------------------------
        # 1. Positives: Weight 1.0, Label 1
        X_train_final = [X_pos]
        y_train_final = [np.ones(len(X_pos))]
        sample_weight_final = [np.ones(len(X_pos))]
        
        # 2. Unlabeled as "Hidden Positive": Weight w, Label 1
        X_train_final.append(X_unlabeled)
        y_train_final.append(np.ones(len(X_unlabeled)))
        sample_weight_final.append(weights_unlabeled)
        
        # 3. Unlabeled as "True Negative": Weight (1-w), Label 0
        X_train_final.append(X_unlabeled)
        y_train_final.append(np.zeros(len(X_unlabeled)))
        sample_weight_final.append(1.0 - weights_unlabeled)
        
        # Stack everything
        X_train_final = np.vstack(X_train_final)
        y_train_final = np.concatenate(y_train_final)
        sample_weight_final = np.concatenate(sample_weight_final)
        
        print(f"Final Training Size: {len(X_train_final)} rows (due to weighting duplication)")
        
        # ---------------------------------------------------------
        # TRAIN FINAL CLASSIFIER
        # ---------------------------------------------------------
        print("--- Step 3: Training Final Classifier ---")
        self.final_estimator = xgb.XGBClassifier(
            n_estimators=300,
            max_depth=5,
            learning_rate=0.05,
            n_jobs=self.n_jobs,
            random_state=self.random_state,
            objective='binary:logistic'
        )
        
        self.final_estimator.fit(
            X_train_final, 
            y_train_final, 
            sample_weight=sample_weight_final
        )
        print("Done.")
        return self

    def predict_proba(self, X):
        return self.final_estimator.predict_proba(X)

    def predict(self, X, threshold=0.5):
        probs = self.predict_proba(X)[:, 1]
        return (probs >= threshold).astype(int)

