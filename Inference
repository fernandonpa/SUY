import torch
import numpy as np
from sklearn.metrics import classification_report, roc_auc_score, confusion_matrix
import matplotlib.pyplot as plt
import seaborn as sns

def get_dae_predictions(model, X_data, scaler, device):
    """
    Wrapper to get probabilities from the PyTorch DAE model.
    """
    model.eval() # Set to evaluation mode (Critical!)
    
    # 1. Scale the data (MUST use the scaler fitted on Train data)
    # Note: Use .transform(), NOT .fit_transform()
    X_scaled = scaler.transform(X_data)
    
    # 2. Convert to Tensor
    X_tensor = torch.tensor(X_scaled, dtype=torch.float32).to(device)
    
    # 3. Inference
    with torch.no_grad(): # Disable gradient calculation for speed
        # Forward pass in 'classify' mode to get raw logits
        logits = model(X_tensor, mode='classify')
        
        # Apply Sigmoid to get probability (0 to 1)
        # Note: If your model.head already has Sigmoid, remove torch.sigmoid here
        # The architecture I gave you earlier INCLUDES Sigmoid in self.head
        probs = logits.cpu().numpy().flatten()
        
    return probs

